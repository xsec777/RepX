{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepX",
  "version": "1.0.0",
  "identifier": "com.repx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RepX",
        "width": 1180,
        "height": 740,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#1E1E1E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "下一代轻量级 AI-Native HTTP 重放与流量审计工作台",
    "longDescription": "RepX 是专为白帽子与 AI 协同设计的轻量级 HTTP 重放与流量审计工作台，具备项目物理隔离与 MCP/REST 双通道。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
